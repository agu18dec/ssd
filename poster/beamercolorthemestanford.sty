% Stanford color theme for the Gemini poster theme
% Adapted from beamercolorthemegemini.sty with Stanford identity colors

% ====================
% Definitions
% ====================

\definecolor{lightgray}{RGB}{245, 246, 250}
\definecolor{cardinalred}{RGB}{140, 21, 21}   % Stanford Cardinal Red #8C1515
\definecolor{darkred}{RGB}{100, 15, 15}
\definecolor{lightblue}{RGB}{232, 244, 255}
\definecolor{stanfordcool}{RGB}{83, 40, 79}

% ====================
% Theme
% ====================

% Basic colors
\setbeamercolor{palette primary}{fg=black,bg=white}
\setbeamercolor{palette secondary}{fg=black,bg=white}
\setbeamercolor{palette tertiary}{bg=black,fg=white}
\setbeamercolor{palette quaternary}{fg=black,bg=white}
\setbeamercolor{structure}{fg=cardinalred}

% Headline
\setbeamercolor{headline}{fg=cardinalred,bg=lightblue}
\setbeamercolor{headline rule}{bg=darkred}

% Block
\setbeamercolor{block title}{fg=cardinalred,bg=white}
\setbeamercolor{block separator}{bg=black}
\setbeamercolor{block body}{fg=black,bg=white}

% Alert Block
\setbeamercolor{block title alerted}{fg=cardinalred,bg=lightblue}
\setbeamercolor{block separator alerted}{bg=black}
\setbeamercolor{block body alerted}{fg=black,bg=lightblue}

% Example Block
\setbeamercolor{block title example}{fg=cardinalred,bg=lightgray}
\setbeamercolor{block separator example}{bg=black}
\setbeamercolor{block body example}{fg=black,bg=lightgray}

% Heading
\setbeamercolor{heading}{fg=black}

% Itemize
\setbeamercolor{item}{fg=cardinalred}

% Bibliography
\setbeamercolor{bibliography item}{fg=black}
\setbeamercolor{bibliography entry author}{fg=black}
\setbeamercolor{bibliography entry title}{fg=black}
\setbeamercolor{bibliography entry location}{fg=black}
\setbeamercolor{bibliography entry note}{fg=black}
